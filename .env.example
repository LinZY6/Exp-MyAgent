# Copy to .env (never commit). Pi reads these on launch via scripts/pi.ps1.
# Repo: G:\经验\MyAgent

# Experiment memory (defaults are set by scripts/pi.ps1)
# EXPMEM_ROOT=G:\经验\MyAgent\expmem_data
# EXPMEM_PYTHON=G:\经验\MyAgent\.vendor\python\python.exe
# EXPMEM_PROJECT=rec_ctr

# --- pick one provider ---

# Anthropic official
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# DeepSeek
# DEEPSEEK_API_KEY=

# Google Gemini
# GEMINI_API_KEY=

# Optional: JD / company Anthropic-compatible gateway (same pattern as 9n_helloagent)
# Pi uses ANTHROPIC_AUTH_TOKEN as Bearer, not x-api-key.
# LLM_API_KEY=paste_token_here
# LLM_BASE_URL=http://llm-gw.jd.local/anthropic
# LLM_MODEL_ID=Claude-Sonnet-4.6-joybuilder

# Default model override for Pi (provider/id)
# PI_MODEL=anthropic/claude-sonnet-4-6

# Paper-site cookies (used later by domain tools, not by Pi itself)
# PAPER_COOKIE=
